<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact — DevBox Tools</title>
  <meta name="description" content="Get in touch with the DevBox Tools team.">
  <link rel="canonical" href="https://mohamedelmaz.github.io/devbox-tools/contact/">
  <link rel="icon" type="image/x-icon" href="../assets/img/favicon.ico?v=1">
  <link rel="icon" type="image/png" sizes="32x32" href="../assets/img/favicon-32x32.png?v=1">
  <link rel="apple-touch-icon" sizes="180x180" href="../assets/img/apple-touch-icon.png?v=1">
  <link rel="manifest" href="../manifest.webmanifest">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://mohamedelmaz.github.io/devbox-tools/contact/">
  <meta property="og:title" content="Contact — DevBox Tools">
  <meta property="og:description" content="Get in touch with the DevBox Tools team.">
  <meta property="og:image" content="https://mohamedelmaz.github.io/devbox-tools/assets/img/og-cover.png">
  <link rel="stylesheet" href="../assets/css/style.css">
</head>
<body>
  <header>
    <div class="header-inner">
      <a href="../" class="logo">
        <svg viewBox="0 0 192 192" width="32" height="32" aria-hidden="true">
          <rect width="192" height="192" rx="96" fill="#8b5cf6"/>
          <path d="M58 56L88 88L58 120" stroke="white" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <path d="M134 56L104 88L134 120" stroke="white" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
        DevBox
      </a>
      <nav>
        <ul class="nav-links">
          <li><a href="../">Home</a></li>
          <li><a href="../guides/">Guides</a></li>
          <li><a href="../developers/">Developers</a></li>
        </ul>
      </nav>
      <div class="header-actions">
        <button class="theme-toggle" aria-label="Toggle theme">🌙</button>
        <button class="menu-toggle" aria-label="Menu">☰</button>
      </div>
    </div>
  </header>

  <main class="section">
    <div class="container" style="max-width:760px;">
      <h1 class="section-title">Contact</h1>
      <p style="color:var(--text-muted);font-size:1.05rem;line-height:1.8;margin-bottom:24px;">
        We'd love to hear from you. Whether you have a question, feedback, bug report, or partnership idea — reach out.
      </p>
      <div class="bento" style="grid-template-columns: 1fr;">
        <div class="card">
          <h3>General Inquiries</h3>
          <p style="margin-bottom:8px;">For general questions and feedback:</p>
          <a href="mailto:hello@devbox.tools" style="font-weight:600;">hello@devbox.tools</a>
        </div>
        <div class="card">
          <h3>Support</h3>
          <p style="margin-bottom:8px;">For technical support and bug reports:</p>
          <a href="mailto:support@devbox.tools" style="font-weight:600;">support@devbox.tools</a>
        </div>
        <div class="card">
          <h3>Other</h3>
          <p style="margin-bottom:8px;">For everything else:</p>
          <a href="mailto:contact@devbox.tools" style="font-weight:600;">contact@devbox.tools</a>
        </div>
      </div>
    </div>
  </main>

  <footer>
    <div class="network-links">
      <p>Part of WebTools Network:</p>
      <a href="https://mohamedelmaz.github.io/linkqr-tools/">LinkQR Tools — QR & Links</a>
      <a href="https://mohamedelmaz.github.io/shiftfile-tools/">ShiftFile Tools — File Conversion</a>
    </div>
  </footer>

  <script src="../assets/js/app.js"></script>
</body>
</html>
